<file path="src/assets/theme.css">
:root {
  --cyan: #22d3ee;
  --cyan-light: #67e8f9;
  --purple: #a78bfa;
  --purple-light: #c4b5fd;
  
  --bg-primary: #0b1220;
  --bg-card: #111827;
  --bg-card-hover: #172033;
  --border-color: rgba(148, 163, 184, 0.14);
  
  --text-primary: #e5eef8;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  --grid-color: rgba(34, 211, 238, 0.035);
  --shadow-card: 0 12px 30px -16px rgba(2, 8, 23, 0.55), 0 8px 18px -18px rgba(15, 23, 42, 0.42);
}

.light {
  --cyan: #0f8fa8;
  --cyan-light: #14b8c4;
  --purple: #7c3aed;
  --purple-light: #8b5cf6;

  --bg-primary: #f8fafc;
  --bg-card: #ffffff;
  --bg-card-hover: #fcfdfe;
  --border-color: #e2e8f0;
  
  --text-primary: #1e293b;
  --text-secondary: #475569;
  --text-muted: #64748b;
  
  --grid-color: rgba(148, 163, 184, 0.08);
  --shadow-card: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(15 23 42 / 0.04);
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--bg-primary);
  background-image: 
    linear-gradient(var(--grid-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-color) 1px, transparent 1px);
  background-size: 50px 50px;
  background-position: 0 0;
  min-height: 100vh;
  color: var(--text-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
  animation: moveGrid 8s linear infinite;
}

.light body {
  background-color: var(--bg-primary);
  background-image:
    linear-gradient(var(--grid-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-color) 1px, transparent 1px),
    radial-gradient(circle at top, rgba(15, 143, 168, 0.045), transparent 42%);
  background-size: 64px 64px, 64px 64px, auto;
  animation-duration: 18s;
}

@keyframes moveGrid {
  0% {
    background-position: 0 0;
  }
  100% {
    background-position: 50px -50px;
  }
}

body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(ellipse at 50% 0%, rgba(34, 211, 238, 0.11) 0%, transparent 58%);
  pointer-events: none;
  z-index: -1;
}

.light body::before {
  background: radial-gradient(ellipse at 50% 0%, rgba(15, 143, 168, 0.08) 0%, rgba(255, 255, 255, 0) 60%);
}

.font-mono {
  font-family: 'Inter', sans-serif;
}

html {
  scroll-behavior: smooth;
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg-card);
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, var(--cyan), var(--purple));
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, var(--cyan-light), var(--purple-light));
}

::selection {
  background: rgba(6, 182, 212, 0.3);
  color: #fff;
}

.light ::selection {
  background: rgba(6, 182, 212, 0.4);
  color: #0f172a;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  transition: all 0.25s ease;
  box-shadow: var(--shadow-card);
}

.card:hover {
  transform: translateY(-4px);
  background: var(--bg-card-hover);
  border-color: color-mix(in srgb, var(--cyan) 40%, var(--border-color));
}

.light .card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
