<script setup lang="ts">
import { ref } from 'vue';
import { useI18n } from 'vue-i18n';
import { heroData } from '@/data';

const { t } = useI18n();

const front = ref('cyan');
const biting = ref(false);

function bite(color: string) {
  if (biting.value) return;
  if (front.value === color) return;

  biting.value = true;

  setTimeout(() => {
    front.value = color;
    biting.value = false;
  }, 500);
}
</script>

